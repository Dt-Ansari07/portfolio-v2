# Copy this file to .env.local for local development.
# Never commit the real .env.local file -- it's already in .gitignore.

# --- Contact form email (Resend) -----------------------------------------
# Create a free account at https://resend.com, verify a sending domain (or
# use their shared onboarding@resend.dev sender for testing), then paste
# your API key below.
RESEND_API_KEY=re_your_api_key_here

# Inbox that should receive contact-form submissions.
CONTACT_EMAIL_TO=zulfiqarhussain7777@gmail.com

# --- Site metadata ---------------------------------------------------------
# Public production URL, used in metadata, sitemap.xml, robots.txt, and
# JSON-LD. Must be set correctly before deploying, or search engines will
# index the wrong canonical URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
